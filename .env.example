# Backend configuration. PLATFORM_API_URL and INDEXER_API_URL
# are required; the other values below are the defaults. No API keys or
# secrets are needed.
#
# Don't commit the service URLs: put them in .env (git-ignored) or in your
# host's environment settings.
#
# The binary reads the process environment only. To use this file locally:
#   cp .env.example .env    # then fill in the two service URLs
#   set -a && . ./.env && set +a && cargo run

# Platform API (auth, bots, arena, leaderboard), as a bare https origin.
PLATFORM_API_URL=

# Indexer API (token charts), as a bare https origin.
INDEXER_API_URL=

# Port the gateway listens on (all interfaces).
PORT=8080

# Used twice. First, the limit for reading the client's request body (on
# expiry the gateway answers 408). Then, separately, the limit for one upstream
# call, from connect until the whole response body is read (on expiry: 502).
# A slow body followed by a slow upstream can take up to twice this value.
UPSTREAM_TIMEOUT_MS=15000

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info
