# Backend configuration. PLATFORM_API_URL is required; HOOD_API_URL is
# optional; the other values below are the defaults. No API keys or secrets
# are needed.
#
# Don't commit the service URLs: put it in .env (git-ignored) or in your
# host's environment settings.
#
# The binary reads the process environment only. To use this file locally:
#   cp .env.example .env    # then fill in PLATFORM_API_URL
#   set -a && . ./.env && set +a && cargo run

# Platform API (auth, bots, arena, leaderboard), as a bare https origin.
# For local testing: https://api-dev.trenchers.ai
PLATFORM_API_URL=

# Robinhood Chain read API (st-indexerd-evm, the evm-api service), as a bare
# https origin. Optional: while unset, the /robinhood/* routes answer 503.
# A test tenant serves it at https://t-hood-<namespace>.trenchers.ai
HOOD_API_URL=

# Port the gateway listens on (all interfaces).
PORT=8080

# Used twice. First, the limit for reading the client's request body, on every
# route (on expiry the gateway answers 408). Then, separately, the default limit
# for one upstream call, from connect until the whole response body is read (on
# expiry: 502). Routes that move money set a longer upstream timeout in
# src/routes.rs; this value is their floor, so raising it never shortens them.
# A slow body followed by a slow upstream can take the two limits added up.
UPSTREAM_TIMEOUT_MS=15000

# Log filter (tracing EnvFilter syntax).
RUST_LOG=info
